# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env (it is gitignored).
# Before sharing this repo/a copy of it, revoke or rotate any credentials you
# have ever placed in .env. Values here are referenced indirectly by
# config/accounts.yaml via `env:` keys, so credentials never live in YAML.
# ---------------------------------------------------------------------------

# --- Bluesky (AT Protocol) -------------------------------------------------
# Create an app password: https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- X (Twitter) — OPTIONAL ------------------------------------------------
# X is published via Playwright by default (browser session, no API cost).
# Auth once:  media-sharing login x <account>
# Only set these if you choose the paid API path (backend: x_api).
# OAuth 1.0a user context:
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- TikTok (Content Posting API) -----------------------------------------
# OAuth user access token + open_id, scopes: video.publish / video.upload
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- Kwai (Playwright session, no official posting API) --------------------
# No credential vars: authentication is a persisted browser session
# (src/media_sharing/sessions/<account>.json). Run `media-sharing kwai-login`.

# --- Aggregator (optional fallback, e.g. Upload-Post / Ayrshare) -----------
AGGREGATOR_API_KEY=
AGGREGATOR_PROFILE=

# --- Optional transient media host (only needed by URL-only platforms) -----
# Public base URL exposed by a tunnel in front of the local server, e.g.
MEDIA_PUBLIC_BASE_URL=
